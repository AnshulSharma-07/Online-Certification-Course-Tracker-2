NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/certification_tracker
# Use a long random value (32+ chars is enforced in production): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Cookies: keep 'lax' when client and API share a site. Use 'none' (HTTPS only) if they're on different domains.
COOKIE_SAMESITE=lax
# Set to 1 when running behind one reverse proxy (Render, Railway, Heroku, nginx)
TRUST_PROXY=

# Seed accounts (npm run seed). Passwords must be 10+ characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdmin123!
SEED_FACULTY_EMAIL=faculty@example.com
SEED_FACULTY_PASSWORD=ChangeThisFaculty123!
SEED_FACULTY_DEPARTMENT=Computer Science
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=ChangeThisStudent123!

# Proof file storage. Leave Cloudinary blank to store uploads on local disk (server/uploads, or UPLOAD_DIR).
# With Cloudinary set, files are uploaded as 'authenticated' (private) and served via signed URLs.
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
